---
import { cn } from '@/lib/utils/cn'

import ContactForm from './ContactForm.astro'

type Props = {
  className?: string
}

const { className } = Astro.props

const whatsappUrl =
  'https://wa.me/919161055529?text=' +
  encodeURIComponent(
    'Hi team, I would like to discuss a software project for my business.',
  )
---

<section
  id="contact"
  class={cn(
    'py-24 sm:py-32 px-4 sm:px-10 md:px-16 bg-[var(--paper)] text-[var(--ink)] relative overflow-hidden border-t border-[var(--azure-white)]/20 rounded-3xl',
    className,
  )}
>
  <div class="max-w-[1440px] mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.3fr] gap-12 lg:gap-20 items-start">
      <!-- Left Column: Direct Info -->
      <div>
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-[var(--signal-pink)] mb-4 block font-semibold">
          // LET'S TALK
        </span>

        <h2 class="hero-display text-[var(--ink)] tracking-tight leading-[0.95] mb-8 uppercase">
          HAVE A SOFTWARE
          <br />
          <span class="text-[var(--signal-pink)]">PROJECT IN MIND?</span>
        </h2>

        <p class="text-sm sm:text-base text-[var(--ink-muted)]/70 leading-relaxed font-sans mb-10 max-w-md">
          Whether you need a high-performance web platform, custom software architecture,
          or AI integration — our freelance engineering team is ready to deliver.
        </p>

        <!-- Direct Contact Channels -->
        <div class="space-y-6 pt-8 border-t border-[var(--azure-white)]/20 max-w-md">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-widest text-[var(--ink-muted)]/40 block mb-1">
              DIRECT EMAIL INQUIRY
            </span>
            <a
              href="mailto:devanshishs@gmail.com"
              class="font-display font-bold text-xl text-[var(--ink)] hover:text-[var(--signal-pink)] transition-colors inline-flex items-center gap-2"
            >
              devanshishs@gmail.com &rarr;
            </a>
          </div>

          <div>
            <span class="text-[10px] font-mono uppercase tracking-widest text-[var(--ink-muted)]/40 block mb-1">
              INSTANT WHATSAPP CHAT
            </span>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-mono uppercase tracking-wider text-emerald-400 hover:text-emerald-300 transition-colors"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Chat on WhatsApp &rarr;
            </a>
          </div>

          <div>
            <span class="text-[10px] font-mono uppercase tracking-widest text-[var(--ink-muted)]/40 block mb-1">
              BOOK A CALL — 30 MIN
            </span>
            <a
              href="https://calendly.com/devanshishs/30min"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-mono uppercase tracking-wider text-[var(--signal-pink)] hover:text-[var(--ink)] transition-colors"
            >
              Book on Calendly &rarr;
            </a>
            <div class="mt-3">
              <span class="text-[10px] font-mono uppercase tracking-widest text-[var(--ink-muted)]/40 block mb-1">
                OR CALL DIRECTLY
              </span>
              <a
                href="tel:+919161055529"
                class="font-display font-bold text-xl text-[var(--ink)] hover:text-[var(--signal-pink)] transition-colors inline-flex items-center gap-2"
              >
                +91-9161055529 &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Embedded Inquiry Portal -->
      <div class="p-8 sm:p-10 rounded-3xl bg-[var(--paper)]/80 border border-[var(--azure-white)]/20 shadow-2xl backdrop-blur-sm">
        <div class="mb-6">
          <span class="font-mono text-xs uppercase tracking-widest text-[var(--signal-pink)] block mb-1 font-semibold">
            PROJECT INQUIRY FORM
          </span>
          <h3 class="font-display font-bold text-2xl text-[var(--ink)] uppercase">
            Start The Conversation
          </h3>
        </div>

        <ContactForm />
      </div>
    </div>
  </div>
</section>
